---
const navItems = [
  { label: "Início", href: "/" },
  { label: "O que é", href: "/o-que-e/" },
  { label: "Composição", href: "/composicao/" },
  { label: "Benefícios", href: "/beneficios/" },
  { label: "Como Usar", href: "/como-usar/" },
  { label: "Contraindicações", href: "/contraindicacoes/" },
  { label: "Depoimentos", href: "/depoimentos/" },
  { label: "Onde Comprar", href: "/onde-comprar/" },
];

const currentPath = Astro.url.pathname;
---

<!-- Nav bar -->
<nav class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100">
  <div class="container mx-auto px-6 lg:px-12">
    <div class="flex items-center justify-between h-[72px]">
      <!-- Logo -->
      <a href="/" class="flex flex-col leading-none">
        <span class="font-display text-2xl font-bold text-brand tracking-tight">Ozenvitta</span>
        <span class="text-[0.65rem] font-semibold text-accent uppercase tracking-[0.15em] mt-0.5">Review</span>
      </a>

      <!-- Desktop links -->
      <ul class="hidden lg:flex items-center gap-8 list-none m-0 p-0">
        {navItems.map(item => (
          <li>
            <a href={item.href} class={`text-sm font-medium hover:text-brand ${currentPath === item.href ? 'text-brand' : 'text-gray-700'}`}>
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/onde-comprar/" class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-white bg-gradient-to-r from-brand to-brand-light px-5 py-2.5 rounded-full hover:shadow-lg hover:-translate-y-0.5 transition-all">
            Oferta Especial
          </a>
        </li>
      </ul>

      <!-- Mobile hamburger -->
      <button
        type="button"
        class="lg:hidden relative z-[60] flex flex-col items-center justify-center w-10 h-10 gap-[5px] bg-transparent border-0 p-0 cursor-pointer"
        aria-label="Menu"
        onclick="var m=document.getElementById('mobMenu'),o=document.getElementById('mobOverlay');if(m.style.display==='block'){m.style.display='none';o.style.display='none';document.body.style.overflow='';}else{m.style.display='block';o.style.display='block';document.body.style.overflow='hidden';}"
      >
        <span class="block w-6 h-[2px] bg-brand"></span>
        <span class="block w-6 h-[2px] bg-brand"></span>
        <span class="block w-6 h-[2px] bg-brand"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Overlay — outside nav to avoid stacking context issues -->
<div
  id="mobOverlay"
  class="fixed inset-0 bg-brand-dark/40 backdrop-blur-sm z-[55] lg:hidden"
  style="display:none"
  onclick="document.getElementById('mobMenu').style.display='none';this.style.display='none';document.body.style.overflow='';"
  aria-hidden="true"></div>

<!-- Menu panel — outside nav to avoid stacking context issues -->
<div
  id="mobMenu"
  class="fixed top-[72px] left-0 right-0 bottom-0 bg-white z-[56] overflow-y-auto lg:hidden"
  style="display:none">
  <div class="container mx-auto px-6 py-8">
    <ul class="flex flex-col gap-1 list-none m-0 p-0">
      {navItems.map(item => (
        <li>
          <a
            href={item.href}
            class="block py-3 px-2 text-gray-700 font-medium hover:text-brand hover:bg-blue-50 rounded-lg transition-colors"
            onclick="document.getElementById('mobMenu').style.display='none';document.getElementById('mobOverlay').style.display='none';document.body.style.overflow='';"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="pt-4">
        <a
          href="/onde-comprar/"
          class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-white bg-gradient-to-r from-brand to-brand-light px-6 py-3 rounded-full"
        >
          Oferta Especial
        </a>
      </li>
    </ul>
  </div>
</div>
