---
const navItems = [
  { label: "Início", href: "/" },
  { label: "O que é", href: "/o-que-e/" },
  { label: "Composição", href: "/composicao/" },
  { label: "Benefícios", href: "/beneficios/" },
  { label: "Como Usar", href: "/como-usar/" },
  { label: "Contraindicações", href: "/contraindicacoes/" },
  { label: "Depoimentos", href: "/depoimentos/" },
  { label: "Onde Comprar", href: "/onde-comprar/" },
];

const currentPath = Astro.url.pathname;
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-surface/95 backdrop-blur-md border-b border-brand/5">
  <div class="container mx-auto px-6 lg:px-12">
    <div class="flex items-center justify-between h-[72px]">
      <a href="/" class="flex flex-col leading-none relative z-[60]">
        <span class="font-display text-2xl font-bold text-brand tracking-tight">Ozenvitta</span>
        <span class="text-[0.65rem] font-semibold text-accent uppercase tracking-[0.15em] mt-0.5">Review</span>
      </a>

      <!-- Desktop nav -->
      <ul class="hidden lg:flex items-center gap-8 list-none m-0 p-0">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class={`text-sm font-medium transition-colors hover:text-brand ${currentPath === item.href ? 'text-brand' : 'text-brand-dark/90'}`}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/onde-comprar/" class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-white bg-gradient-to-r from-brand to-brand-light px-5 py-2.5 rounded-full hover:shadow-lg hover:-translate-y-0.5 transition-all">
            Oferta Especial
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Mobile: links always visible, stacked horizontally with scroll -->
  <div class="lg:hidden border-t border-brand/5 bg-surface/95 backdrop-blur-md">
    <div class="container mx-auto px-6">
      <div class="flex items-center gap-4 overflow-x-auto py-2 no-scrollbar" style="-webkit-overflow-scrolling:touch">
        {navItems.map(item => (
          <a
            href={item.href}
            class={`whitespace-nowrap text-xs font-medium transition-colors hover:text-brand ${currentPath === item.href ? 'text-brand' : 'text-brand-dark/80'}`}
          >
            {item.label}
          </a>
        ))}
        <a
          href="/onde-comprar/"
          class="whitespace-nowrap inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-white bg-gradient-to-r from-brand to-brand-light px-3 py-1.5 rounded-full flex-shrink-0"
        >
          Comprar
        </a>
      </div>
    </div>
  </div>
</nav>
