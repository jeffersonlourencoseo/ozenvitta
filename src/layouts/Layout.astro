---
import SEO from '../components/SEO.astro';
import SchemaMarkup from '../components/SchemaMarkup.astro';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: string;
  ogAlt?: string;
  schemaType?: 'home' | 'product' | 'page' | 'faq' | 'article';
  schemaTitle?: string;
  schemaDesc?: string;
  schemaImage?: string;
  schemaFaq?: Array<{ question: string; answer: string }>;
  breadcrumbs?: Array<{ name: string; url: string }>;
  schemaHowTo?: Array<{ name: string; text: string; image?: string }>;
}

const {
  title,
  description,
  keywords,
  image,
  canonical,
  noindex = false,
  ogType = 'website',
  ogAlt,
  schemaType = 'page',
  schemaTitle,
  schemaDesc,
  schemaImage,
  schemaFaq,
  breadcrumbs,
  schemaHowTo,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <SEO
    title={title}
    description={description}
    keywords={keywords}
    image={image}
    canonical={canonical}
    noindex={noindex}
    ogType={ogType}
    ogAlt={ogAlt}
  />

  <!-- Fontes: usamos apenas system fonts para eliminar CLS de font-display: swap -->

  <style is:global>
    html {
      scroll-behavior: smooth;
      scroll-padding-top: 88px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    ::selection {
      background-color: #1B3A6B;
      color: #fff;
    }

    /* Fontes do sistema apenas: elimina download e CLS de font-display: swap.
       Georgia para títulos é próxima visualmente a Cormorant Garamond. */
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    }

    h1, h2, h3, h4 {
      font-family: Georgia, 'Times New Roman', 'Songti SC', 'SimSun', serif;
      text-wrap: balance;
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body class="bg-surface text-brand-dark antialiased">
  <slot />

  <!-- Schema JSON-LD — movido para o final do body para não bloquear renderização -->
  <SchemaMarkup
    type={schemaType}
    title={schemaTitle || title}
    description={schemaDesc || description}
    image={schemaImage || image}
    faqData={schemaFaq}
    breadcrumbs={breadcrumbs}
    howToData={schemaHowTo}
  />
</body>
</html>
