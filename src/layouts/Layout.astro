---
import SEO from '../components/SEO.astro';
import SchemaMarkup from '../components/SchemaMarkup.astro';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: string;
  ogAlt?: string;
  schemaType?: 'home' | 'product' | 'page' | 'faq' | 'article';
  schemaTitle?: string;
  schemaDesc?: string;
  schemaImage?: string;
  schemaFaq?: Array<{ question: string; answer: string }>;
  breadcrumbs?: Array<{ name: string; url: string }>;
  schemaHowTo?: Array<{ name: string; text: string; image?: string }>;
}

const {
  title,
  description,
  keywords,
  image,
  canonical,
  noindex = false,
  ogType = 'website',
  ogAlt,
  schemaType = 'page',
  schemaTitle,
  schemaDesc,
  schemaImage,
  schemaFaq,
  breadcrumbs,
  schemaHowTo,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <SEO
    title={title}
    description={description}
    keywords={keywords}
    image={image}
    canonical={canonical}
    noindex={noindex}
    ogType={ogType}
    ogAlt={ogAlt}
  />

  <!-- Fontes não-críticas carregadas lazy via stylesheet -->
  <link rel="stylesheet" href="/fonts/fonts-deferred.css" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="/fonts/fonts-deferred.css" /></noscript>

  <style is:global>
    html {
      scroll-behavior: smooth;
      scroll-padding-top: 88px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    ::selection {
      background-color: #1B3A6B;
      color: #fff;
    }

    /* Fallback de fontes nativas sem download para evitar CLS de font-display: swap.
       A fonte web só é usada depois de carregada; se não carregar, o fallback já
       tem métricas similares e não gera salto visível. */
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    }

    h1, h2, h3, h4 {
      font-family: Georgia, 'Times New Roman', 'Songti SC', 'SimSun', serif;
      text-wrap: balance;
    }

    /* Fontes web carregadas via stylesheet lazy; se falharem ou demorarem,
       o layout não quebra */
    .fonts-loaded body {
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    .fonts-loaded h1, .fonts-loaded h2, .fonts-loaded h3, .fonts-loaded h4 {
      font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body class="bg-surface text-brand-dark antialiased">
  <slot />

  <!-- CTA Sticky Mobile -->
  <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-brand/10 p-3 z-50 lg:hidden shadow-[0_-4px_20px_rgba(0,0,0,0.1)]">
    <a href="https://app.monetizze.com.br/r/ATX25785612"
       target="_blank"
       class="flex items-center justify-center gap-2 text-sm font-bold uppercase tracking-wider text-white bg-brand w-full py-3 rounded-full"
       rel="noopener noreferrer nofollow sponsored"
    >
      Comprar com Desconto
    </a>
  </div>

  <!-- Schema JSON-LD — movido para o final do body para não bloquear renderização -->
  <SchemaMarkup
    type={schemaType}
    title={schemaTitle || title}
    description={schemaDesc || description}
    image={schemaImage || image}
    faqData={schemaFaq}
    breadcrumbs={breadcrumbs}
    howToData={schemaHowTo}
  />
</body>
</html>
