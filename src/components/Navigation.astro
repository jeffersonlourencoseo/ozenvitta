---
const navItems = [
  { label: "Início", href: "/" },
  { label: "O que é", href: "/o-que-e/" },
  { label: "Composição", href: "/composicao/" },
  { label: "Benefícios", href: "/beneficios/" },
  { label: "Como Usar", href: "/como-usar/" },
  { label: "Contraindicações", href: "/contraindicacoes/" },
  { label: "Depoimentos", href: "/depoimentos/" },
  { label: "Onde Comprar", href: "/onde-comprar/" },
];

const currentPath = Astro.url.pathname;
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100">
  <div class="container mx-auto px-6 lg:px-12">
    <div class="flex items-center justify-between h-[72px]">
      <a href="/" class="flex flex-col leading-none">
        <span class="font-display text-2xl font-bold text-brand tracking-tight">Ozenvitta</span>
        <span class="text-[0.65rem] font-semibold text-accent uppercase tracking-[0.15em] mt-0.5">Review</span>
      </a>

      <ul class="hidden lg:flex items-center gap-8 list-none m-0 p-0">
        {navItems.map(item => (
          <li>
            <a href={item.href} class={`text-sm font-medium hover:text-brand ${currentPath === item.href ? 'text-brand' : 'text-gray-700'}`}>
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/onde-comprar/" class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-white bg-gradient-to-r from-brand to-brand-light px-5 py-2.5 rounded-full hover:shadow-lg hover:-translate-y-0.5 transition-all">
            Oferta Especial
          </a>
        </li>
      </ul>

      <!-- Mobile: pure HTML details/summary, zero JS -->
      <details class="lg:hidden" style="list-style:none;position:relative;z-index:9999">
        <summary style="list-style:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;width:40px;height:40px;gap:5px;background:transparent;border:none;padding:0;position:relative;z-index:9999">
          <span style="display:block;width:24px;height:2px;background:#1e3a8a"></span>
          <span style="display:block;width:24px;height:2px;background:#1e3a8a"></span>
          <span style="display:block;width:24px;height:2px;background:#1e3a8a"></span>
        </summary>

        <!-- Full-screen overlay + menu -->
        <div style="position:fixed;inset:0;z-index:9998" onclick="this.parentElement.removeAttribute('open')">
          <div style="position:fixed;inset:0;background:rgba(31,20,66,0.4);backdrop-filter:blur(4px);z-index:9998"></div>
          <div style="position:fixed;top:72px;left:0;right:0;bottom:0;background:#fff;z-index:9999;overflow-y:auto;padding:24px">
            <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px">
              {navItems.map(item => (
                <li>
                  <a href={item.href} style="display:block;padding:12px 8px;color:#374151;font-weight:500;text-decoration:none;border-radius:8px" onmouseover="this.style.backgroundColor='#eff6ff'" onmouseout="this.style.backgroundColor='transparent'" onclick="this.closest('details').removeAttribute('open')">
                    {item.label}
                  </a>
                </li>
              ))}
              <li style="padding-top:16px">
                <a href="/onde-comprar/" style="display:inline-flex;align-items:center;gap:8px;padding:12px 24px;background:linear-gradient(90deg,#1e3a8a,#7361ae);color:#fff;border-radius:9999px;text-decoration:none;font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em">
                  Oferta Especial
                </a>
              </li>
            </ul>
          </div>
        </div>
      </details>
    </div>
  </div>
</nav>
